{
  "manifest_version": 3,
  "name": "GitStreak Tracker",
  "version": "1.0.0",
  "description": "Track your GitHub contribution streak in real-time.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "512": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://git-streak-phi.vercel.app/*",
    "https://*.github.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gitstreak@yonandualem.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "512": "icons/icon128.png"
  }
}
