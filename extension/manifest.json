{
  "manifest_version": 3,
  "name": "GitStreak Tracker",
  "version": "1.0.0",
  "description": "Track your GitHub contribution streak in real-time.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
