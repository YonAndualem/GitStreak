{
  "manifest_version": 3,
  "name": "GitStreak Tracker",
  "version": "1.0.0",
  "description": "Track your GitHub contribution streak in real-time.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://git-streak-phi.vercel.app/*",
    "https://*.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
